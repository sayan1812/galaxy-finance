# ==============================================================================
# Galaxy Finance - Environment Configuration Template
# ==============================================================================

# Server Port (Default: 5000)
PORT=5000

# Environment Mode: development | test | production
NODE_ENV=development

# JWT Secret for Auth Token Generation
JWT_SECRET=galaxy_finance_secure_secret_key_change_in_production

# Database File Path
DB_PATH=./server/rupeewise.db

# ==============================================================================
# Firebase Authentication Web SDK Configuration
# Replace these with your project values from Firebase Console:
# Project Overview > Project Settings > General > Your Apps > Web App
# ==============================================================================
VITE_FIREBASE_API_KEY=AIzaSyYourFirebaseApiKeyHere
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
VITE_FIREBASE_MEASUREMENT_ID=G-ABCDEFGHIJ
