# ==============================================================================
# Galaxy Finance - Backend Environment Variables
# ==============================================================================

# Server Port (Default: 5000)
PORT=5000

# Environment Mode: development | test | production
NODE_ENV=development

# JWT Secret for Auth Token Generation
JWT_SECRET=galaxy_finance_secure_secret_key_change_in_production

# Optional Database File Override (Defaults to server/rupeewise.db)
# DB_PATH=./server/rupeewise.db
