# ==============================================================================
# Galaxy Finance Mobile - Environment Configuration
# ==============================================================================

# API Base URL for Expo App
# For iOS Simulator / Web: http://localhost:5000
# For Android Emulator: http://10.0.2.2:5000
# For Physical Device (Expo Go / Dev Client): http://<YOUR_LAN_IP>:5000 (e.g. http://192.168.1.100:5000)
EXPO_PUBLIC_API_URL=http://localhost:5000

# EAS Project ID (optional, configured in app.json extra.eas.projectId)
# EAS_PROJECT_ID=
